      "name": "Not Reviewed Yet"
    },
    {
      "parameters": {
        "jsCode": "const files = $input.all().map(item => item.json);\nconst metadata = $('Get PR Metadata').first().json;\nconst results = [];\n\nif (files.length !== Number(metadata.changed_files)) {\n  throw new Error('Получены не все файлы PR. Проверь пагинацию.');\n}\n\nfor (let fileIndex = 0; fileIndex < files.length; fileIndex++) {\n  const file = files[fileIndex];\n\n  // Простое переименование без изменения содержимого.\n  if (file.status === 'renamed' && file.changes === 0) continue;\n\n  if (typeof file.patch !== 'string') {\n    throw new Error('Нет текстового patch для файла: ' + file.filename);\n  }\n\n  let block = null;\n  let oldLine = 0;\n  let newLine = 0;\n  let blockNumber = 0;\n\n  function finishBlock() {\n    if (!block) return;\n\n    if (\n      oldLine !== block.oldStart + block.oldCount ||\n      newLine !== block.newStart + block.newCount\n    ) {\n      throw new Error('Неполный patch: ' + file.filename);\n    }\n\n    const anchor = block.added ?? block.removed;\n\n    if (!anchor) {\n      throw new Error('Блок без изменений: ' + file.filename);\n    }\n\n    results.push({\n      json: {\n        path: file.filename,\n        block_number: ++blockNumber,\n        line: anchor.line,\n        side: anchor.side,\n        diff: block.lines.join('\\n')\n      },\n      pairedItem: { item: fileIndex }\n    });\n\n    block = null;\n  }\n\n  const lines = file.patch.replace(/\\r\\n/g, '\\n').split('\\n');\n  if (lines[lines.length - 1] === '') lines.pop();\n\n  for (const text of lines) {\n    const header = text.match(\n      /^@@ -(\\d+)(?:,(\\d+))? \\+(\\d+)(?:,(\\d+))? @@/\n    );\n\n    if (header) {\n      finishBlock();\n\n      oldLine = Number(header[1]);\n      newLine = Number(header[3]);\n\n      block = {\n        oldStart: oldLine,\n        newStart: newLine,\n        oldCount: Number(header[2] ?? 1),\n        newCount: Number(header[4] ?? 1),\n        lines: [text],\n        added: null,\n        removed: null\n      };\n\n      continue;\n    }\n\n    if (!block) continue;\n\n    block.lines.push(text);\n\n    if (text.startsWith('+')) {\n      block.added ??= { line: newLine, side: 'RIGHT' };\n      newLine++;\n    } else if (text.startsWith('-')) {\n      block.removed ??= { line: oldLine, side: 'LEFT' };\n      oldLine++;\n    } else if (text.startsWith(' ')) {\n      oldLine++;\n      newLine++;\n    } else if (!text.startsWith('\\\\')) {\n      throw new Error('Неизвестная строка patch: ' + file.filename);\n    }\n  }\n\n  finishBlock();\n}\n\nif (results.length === 0) {\n  throw new Error('Нет текстовых блоков для ревью.');\n}\n\nreturn results;"
      },
