        "jsCode": "const items = $input.all();\nconst expected = $('Split Diff Blocks').all().length;\n\nif (items.length !== expected) {\n  throw new Error(\n    `Обработаны не все блоки: ${items.length} из ${expected}`\n  );\n}\n\nconst comments = items.map(({ json }, index) => {\n  const line = Number(json.line);\n\n  if (\n    typeof json.path !== 'string' ||\n    !json.path ||\n    !Number.isInteger(line) ||\n    line < 1 ||\n    !['LEFT', 'RIGHT'].includes(json.side) ||\n    typeof json.body !== 'string' ||\n    !json.body.trim()\n  ) {\n    throw new Error('Некорректный комментарий к блоку ' + (index + 1));\n  }\n\n  return {\n    path: json.path,\n    line,\n    side: json.side,\n    body: json.body.trim()\n  };\n});\n\nconst metadata = $('Get PR Metadata').first().json;\nconst context = $('PR Context').first().json;\n\nif (!metadata.head?.sha) {\n  throw new Error('Не найден SHA коммита в Get PR Metadata');\n}\n\nreturn [{\n  json: {\n    commit_id: metadata.head.sha,\n    event: 'COMMENT',\n    body:\n      `AI Review — ${context.review_kind}. ` +\n      `Проверено блоков: ${comments.length}.`,\n    comments\n  }\n}];"
      },
