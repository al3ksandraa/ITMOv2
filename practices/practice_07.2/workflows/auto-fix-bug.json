    {
      "parameters": {
        "jsCode": "const commit = $input.first().json.body;\nconst fix = $('Validate Fix').first().json;\nconst pr = $('Create PR').first().json.body;\nconst fixSha = $('Write Fix').first().json.body.commit.sha;\nconst files = commit.files ?? [];\nconst file = files[0];\n\nif (commit.sha !== fixSha || pr.head.sha !== fixSha) {\n  throw new Error('SHA коммита не совпадает с вершиной PR');\n}\n\nif (commit.parents?.length !== 1 || commit.parents[0].sha !== fix.baseSha) {\n  throw new Error('Коммит создан от другого SHA основной ветки');\n}\n\nif (\n  files.length !== 1 ||\n  file?.filename !== 'calculator.py' ||\n  file.status !== 'modified' ||\n  !file.patch\n) {\n  throw new Error('Ожидалось изменение только в calculator.py');\n}\n\nreturn [{\n  json: {\n    title: fix.title,\n    body: fix.body,\n    tests: fix.tests,\n    patch: file.patch,\n    fixSha,\n    prNumber: pr.number,\n    baseSha: fix.baseSha,\n    baseBranch: fix.baseBranch,\n    fixBranch: fix.fixBranch,\n  },\n}];"
      },
