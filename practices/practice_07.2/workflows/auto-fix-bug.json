        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"status\": { \"type\": \"string\", \"enum\": [\"fix\", \"skip\"] },\n    \"replacement\": { \"type\": \"string\" },\n    \"summary\": { \"type\": \"string\" }\n  },\n  \"required\": [\"status\", \"replacement\", \"summary\"],\n  \"additionalProperties\": false\n}"
