    {
      "parameters": {
        "jsCode": "const output = $input.first().json;\nconst candidate = output.output ?? output.text ?? output;\nconst context = $('Prepare Context').first().json;\n\nconst replacement = candidate?.replacement;\nconst ok = candidate?.status === 'fix'\n  && typeof replacement === 'string'\n  && replacement.trim().length > 0\n  && replacement.trim() !== context.source.trim();\n\nreturn [{\n  json: {\n    ...context,\n    ok,\n    summary: candidate?.summary ?? '',\n    ...(ok ? { replacement } : {}),\n  },\n}];"
