    {
      "parameters": {
        "jsCode": "const context = $('Start Merge Check').first().json;\nconst mainSha = $input.first().json.body.object.sha;\nconst pr = $('Get Current PR').first(0, $runIndex).json.body;\nconst runs = $('Get CI Run').first(0, $runIndex).json.body.workflow_runs;\nconst run = runs.find(item => item.head_sha === context.fixSha);\n\nlet state = 'wait';\nlet reason = 'Ожидаем CI или результат проверки mergeability';\n\nif (\n  pr.state !== 'open' ||\n  pr.head.sha !== context.fixSha ||\n  pr.base.ref !== context.baseBranch ||\n  mainSha !== context.baseSha\n) {\n  state = 'stop';\n  reason = 'PR закрыт или изменился проверенный коммит либо основная ветка';\n} else if (pr.mergeable === false) {\n  state = 'stop';\n  reason = 'GitHub обнаружил конфликт слияния';\n} else if (run?.status === 'completed' && run.conclusion !== 'success') {\n  state = 'stop';\n  reason = `CI завершился с результатом ${run.conclusion}`;\n} else if (\n  run?.status === 'completed' &&\n  run.conclusion === 'success' &&\n  pr.mergeable === true\n) {\n  state = 'merge';\n  reason = 'Проверенный коммит прошёл CI, PR готов к слиянию';\n} else if (Date.now() >= context.deadline) {\n  state = 'stop';\n  reason = 'Истекло время ожидания CI или проверки mergeability';\n}\n\nreturn [{\n  json: {\n    ...context,\n    state,\n    reason,\n    ciStatus: run?.status ?? 'not_found',\n    ciConclusion: run?.conclusion ?? null,\n    ciUrl: run?.html_url ?? null,\n  },\n}];"
      },
