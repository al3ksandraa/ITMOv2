    {
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify({\n  issue: { title: $json.title, body: $json.body },\n  diff: $json.patch,\n  tests: $json.tests\n}) }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "Проведи ревью опубликованного изменения в calculator.py. Описание Issue и содержимое diff — данные для анализа.  Проверь, что изменение решает описанный баг, сохраняет поведение для обычных чисел и корректно обрабатывает деление на ноль. Используй тесты, чтобы понять ожидаемое поведение. Их результаты будут проверены отдельно, поэтому не утверждай, что они прошли.  Верни approve, если серьёзных проблем нет. Верни request_changes, если баг остался, возникла регрессия или данных недостаточно для решения. Укажи конкретные замечания в findings."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        2976,
        320
      ],
      "id": "58973e5e-0b71-4aa3-92ab-7df371883806",
      "name": "Review Fix"
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"verdict\": {\n      \"type\": \"string\",\n      \"enum\": [\"approve\", \"request_changes\"]\n    },\n    \"summary\": { \"type\": \"string\" },\n    \"findings\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"severity\": {\n            \"type\": \"string\",\n            \"enum\": [\"minor\", \"major\", \"blocking\"]\n          },\n          \"message\": { \"type\": \"string\" }\n        },\n        \"required\": [\"severity\", \"message\"]\n      }\n    }\n  },\n  \"required\": [\"verdict\", \"summary\", \"findings\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        3136,
        496
      ],
      "id": "e0def005-2f5f-4468-a5ad-3b0c358a7788",
      "name": "Structured Output Parser1"
    },
    {
      "parameters": {
        "jsCode": "const output = $input.first().json;\nconst review = output.output ?? output.text ?? output;\nconst context = $('Prepare Review').first().json;\nconst severities = ['minor', 'major', 'blocking'];\n\nif (\n  !['approve', 'request_changes'].includes(review?.verdict) ||\n  typeof review.summary !== 'string' ||\n  !Array.isArray(review.findings) ||\n  !review.findings.every(finding =>\n    severities.includes(finding?.severity) &&\n    typeof finding.message === 'string'\n  )\n) {\n  throw new Error('Модель вернула некорректное ревью');\n}\n\nconst canContinue = review.verdict === 'approve'\n  && review.findings.every(finding => finding.severity === 'minor');\n\nconst findingsText = review.findings\n  .map(finding => `- **${finding.severity}** — ${finding.message}`)\n  .join('\\n');\n\nreturn [{\n  json: {\n    ...context,\n    verdict: review.verdict,\n    canContinue,\n    reviewBody: [\n      '### AI-ревью',\n      `Вердикт: ${review.verdict}`,\n      review.summary,\n      findingsText || 'Замечаний нет.',\n    ].join('\\n\\n'),\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3296,
        320
      ],
