        "jsCode": "const issue = $('Prepare').first().json;\nconst calculator = $('Get Calculator').first().json.body;\nconst tests = $('Get Tests').first().json.body;\n\nfunction decodeBase64(content) {\n  // @ts-ignore — Buffer доступен в JavaScript-раннере n8n\n  return Buffer.from(content, 'base64').toString('utf8');\n}\n\nreturn [{\n  json: {\n    ...issue,\n    baseSha: $('Get Main').first().json.body.object.sha,\n    sourceBlobSha: calculator.sha,\n    source: decodeBase64(calculator.content),\n    tests: decodeBase64(tests.content),\n  },\n}];"
