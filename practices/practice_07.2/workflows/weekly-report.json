    {
      "parameters": {
        "jsCode": "const current = $('Group Issues').first().json;\nconst row = $input.first().json;\nconst previous = row.stats_json ? JSON.parse(row.stats_json) : null;\n\nconst delta = previous\n  ? Object.fromEntries(\n      Object.entries(current.metrics).map(([key, value]) => [\n        key,\n        value - previous.metrics[key],\n      ])\n    )\n  : null;\n\nreturn [{\n  json: {\n    ...current,\n    previousMetrics: previous?.metrics ?? null,\n    delta,\n  },\n}];"
      },
