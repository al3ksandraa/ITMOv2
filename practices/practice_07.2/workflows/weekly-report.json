      "parameters": {
        "jsCode": "const repo = 'al3ksandraa/n8n-review-practice';\nconst testDate = '';\n\nconst now = testDate\n  ? DateTime.fromISO(testDate, { zone: $now.zoneName })\n  : $now;\n\nif (!now.isValid) {\n  throw new Error('Укажи testDate в формате YYYY-MM-DD');\n}\n\nconst thisMonday = now.startOf('week');\nconst start = thisMonday.minus({ weeks: 1 });\nconst lastSecond = thisMonday.minus({ seconds: 1 });\n\nconst range = `${start.toUTC().toISO({ suppressMilliseconds: true })}`\n  + `..${lastSecond.toUTC().toISO({ suppressMilliseconds: true })}`;\n\nconst base = `repo:${repo} is:issue`;\n\nreturn [{\n  json: {\n    repo,\n    weekStart: start.toISODate(),\n    weekEnd: lastSecond.toISODate(),\n    previousWeekStart: start.minus({ weeks: 1 }).toISODate(),\n    queries: {\n      opened: `${base} created:${range}`,\n      closed: `${base} is:closed closed:${range}`,\n      bugs: `${base} label:bug created:${range}`,\n      triage: `${base} label:needs-triage created:${range}`,\n    },\n  },\n}];"
      },
