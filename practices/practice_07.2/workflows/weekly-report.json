    {
      "parameters": {
        "jsCode": "function readIssues(nodeName) {\n  const pages = $(nodeName).all().map(item => item.json);\n\n  if (!pages.length || pages.some(page =>\n    page.incomplete_results || !Array.isArray(page.items)\n  )) {\n    throw new Error(nodeName + ' вернул неполный ответ GitHub');\n  }\n\n  const issues = pages.flatMap(page => page.items);\n  const uniqueIds = new Set(issues.map(issue => issue.id));\n\n  if (issues.length !== pages[0].total_count || uniqueIds.size !== issues.length) {\n    throw new Error(nodeName + ' вернул пропуски или дубли. Проверь пагинацию');\n  }\n\n  return issues;\n}\n\nfunction group(issues) {\n  const types = ['needs-triage', 'bug', 'task', 'feature'];\n  const byType = { bug: 0, task: 0, feature: 0, 'needs-triage': 0, other: 0 };\n  const authors = new Map();\n\n  for (const issue of issues) {\n    const labels = (issue.labels ?? []).map(label => label.name);\n    const type = types.find(value => labels.includes(value)) ?? 'other';\n    byType[type]++;\n\n    const author = issue.user?.login ?? '(неизвестен)';\n    authors.set(author, (authors.get(author) ?? 0) + 1);\n  }\n\n  return { byType, byAuthor: Object.fromEntries(authors) };\n}\n\nconst period = $('Report Period').first().json;\nconst opened = readIssues('Search Opened');\nconst closed = readIssues('Search Closed');\n\nreturn [{\n  json: {\n    repo: period.repo,\n    weekStart: period.weekStart,\n    weekEnd: period.weekEnd,\n    previousWeekStart: period.previousWeekStart,\n    metrics: {\n      opened: opened.length,\n      closed: closed.length,\n      bugs: readIssues('Search Bugs').length,\n      triage: readIssues('Search Triage').length,\n    },\n    opened: group(opened),\n    closed: group(closed),\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1312,
        128
      ],
      "id": "f42f8b7f-ee80-48e2-974d-620b65552a8e",
      "name": "Group Issues"
    },
    {
      "parameters": {
        "jsCode": "const report = $input.first().json;\n\nfunction escapeHtml(value) {\n  const entities = {\n    '&': '&amp;', '<': '&lt;', '>': '&gt;',\n    '\"': '&quot;', \"'\": '&#39;',\n  };\n  return String(value).replace(/[&<>\"']/g, char => entities[char]);\n}\n\nfunction table(headers, rows) {\n  const cell = 'border:1px solid #ccc;padding:6px 10px;text-align:left';\n  const head = headers.map(text =>\n    `<th style=\"${cell}\">${escapeHtml(text)}</th>`\n  ).join('');\n  const body = rows.map(row => `<tr>${row.map(value =>\n    `<td style=\"${cell}\">${escapeHtml(value)}</td>`\n  ).join('')}</tr>`).join('');\n\n  return `<table style=\"border-collapse:collapse\">\n    <thead><tr>${head}</tr></thead><tbody>${body}</tbody>\n  </table>`;\n}\n\nconst metricNames = {\n  opened: 'Создано Issues',\n  closed: 'Закрыто Issues',\n  bugs: 'Создано с меткой bug',\n  triage: 'Создано с меткой needs-triage',\n};\n\nconst showDelta = report.delta != null;\nconst summaryRows = Object.entries(metricNames).map(([key, label]) => {\n  const row = [label, report.metrics[key]];\n  if (showDelta) {\n    const value = report.delta[key];\n    row.push(value > 0 ? `+${value}` : value);\n  }\n  return row;\n});\n\nconst typeRows = Object.keys(report.opened.byType).map(type => [\n  type,\n  report.opened.byType[type],\n  report.closed.byType[type],\n]);\n\nconst authors = new Set([\n  ...Object.keys(report.opened.byAuthor),\n  ...Object.keys(report.closed.byAuthor),\n]);\nconst authorRows = [...authors].sort().map(author => [\n  author,\n  report.opened.byAuthor[author] ?? 0,\n  report.closed.byAuthor[author] ?? 0,\n]);\n\nconst period = `${report.weekStart} — ${report.weekEnd}`;\nconst subject = `GitHub Issues — ${report.repo} — ${period}`;\nconst summaryHeaders = ['Показатель', 'За неделю'];\nif (showDelta) summaryHeaders.push('Δ к прошлой неделе');\n\nconst html = `\n  <h2>Еженедельный отчёт по GitHub Issues</h2>\n  <p>${escapeHtml(report.repo)} · ${escapeHtml(period)}</p>\n  ${table(summaryHeaders, summaryRows)}\n  ${report.delta === null ? '<p>Данных за предыдущую неделю пока нет.</p>' : ''}\n  <h3>По типам</h3>\n  ${table(['Тип', 'Создано', 'Закрыто'], typeRows)}\n  <h3>По авторам Issues</h3>\n  ${table(\n    ['Автор', 'Создано', 'Закрыто'],\n    authorRows.length ? authorRows : [['Нет Issues за неделю', 0, 0]],\n  )}\n  ${report.aiComment\n    ? `<h3>AI-комментарий недели</h3><p>${escapeHtml(report.aiComment)}</p>`\n    : ''}\n`;\n\nreturn [{ json: { subject, html } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
